# Environment: "development" (debug logs) or "production" (warn+ only)
APP_ENV=development

# Token list (optional): ID:pyth_feed_id pairs, comma-separated
# If omitted, all Pyth feeds are auto-discovered.
# DESIRED_TOKENS=BTC:0xe62df6c8b4a85fe1a67db44dc12de5db330f7ac66b72dc658afedf0f4a415b43,ETH:0xff61491a931112ddf1bd8147cd1b641375f79f5825126d665480874634fd0ace

# Stablecoin token IDs (skip Pyth, use fixed price of 1.00)
STABLE_COINS=USDT,USDC

# Fetch interval in seconds
FETCH_INTERVAL_SECONDS=60

# HTTP server port
SERVER_PORT=3000

# Log level override (optional, derived from APP_ENV if not set)
# LOG_LEVEL=debug

# Max minutes of price history to keep per token
HISTORY_CAP_MINUTES=5

# Pyth Hermes API base URL
HERMES_BASE_URL=https://hermes.pyth.network
